<Window x:Class="DisplayRest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DisplayRest" Width="682" Height="725" MinWidth="590" MinHeight="530"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource Background}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="23,19,23,18">
      <DockPanel Margin="0,0,0,13">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                     Foreground="{StaticResource Muted}" />
          <ComboBox x:Name="LanguageBox" Style="{StaticResource LanguagePicker}" Width="155"
                    AutomationProperties.Name="{DynamicResource LanguageLabel}" ToolTip="{DynamicResource LanguageTip}"
                    SelectedValuePath="Tag" SelectionChanged="Language_Changed">
            <ComboBoxItem Tag="System" Content="{DynamicResource LanguageSystem}" />
            <ComboBoxItem Tag="Russian" Content="Русский" Language="ru" />
            <ComboBoxItem Tag="English" Content="English" Language="en" />
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="37" Height="37" CornerRadius="10" Background="#183831" Margin="0,0,11,0">
            <Path Data="M 4,3 H 22 V 15 H 4 Z M 13,15 V 20 M 8,20 H 18 M 17,7 H 19"
                  Width="26" Height="23" Margin="1,2,0,0" Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Border>
          <TextBlock Text="DisplayRest" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Muted}"
                     Margin="8,2,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="Heading" Text="{DynamicResource Heading}" FontSize="29" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource Intro}" Foreground="{StaticResource Muted}" Margin="0,4,0,15" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{DynamicResource HotkeyTitle}" Style="{StaticResource SectionTitle}" />
          <Grid Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="#0E1623" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="11,7" Margin="0,0,8,0" ToolTip="{DynamicResource HotkeyTip}">
              <TextBlock x:Name="ShortcutText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button x:Name="CaptureButton" Grid.Column="1" Click="Capture_Click" MinWidth="113" />
            <Button x:Name="ClearButton" Grid.Column="2" Content="{DynamicResource ClearHotkey}" Click="Clear_Click" Margin="8,0,0,0"
                    ToolTip="{DynamicResource ClearTip}" ToolTipService.ShowOnDisabled="True" />
          </Grid>
          <TextBlock x:Name="ShortcutHint" Style="{StaticResource Hint}" Margin="0,7,0,0" />
          <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Hint}" Margin="0,5,0,0"
                     Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{DynamicResource WakeTitle}" Style="{StaticResource SectionTitle}" />
          <WrapPanel Margin="0,11,0,0">
            <CheckBox x:Name="MouseWake" Content="{DynamicResource WakeMouse}" ToolTip="{DynamicResource WakeMouseTip}" Margin="0,0,22,4"
                      Checked="Wake_Changed" Unchecked="Wake_Changed" />
            <CheckBox x:Name="KeyboardWake" Content="{DynamicResource WakeKeyboard}" ToolTip="{DynamicResource WakeKeyboardTip}" Margin="0,0,0,4"
                      Checked="Wake_Changed" Unchecked="Wake_Changed" />
          </WrapPanel>
          <TextBlock x:Name="WakeHint" Style="{StaticResource Hint}" Margin="0,3,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{DynamicResource TimerTitle}" Style="{StaticResource SectionTitle}" />
          <TextBlock x:Name="SchemeLabel" Style="{StaticResource Hint}" Margin="0,4,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="{DynamicResource AcLabel}" Margin="0,0,0,4" ToolTip="{DynamicResource AcTip}" />
              <TextBox x:Name="AcBox" AutomationProperties.Name="{DynamicResource AcLabel}" Height="36" MaxLength="18"
                       ToolTip="{DynamicResource AcTip}"
                       TextChanged="Timer_Changed" KeyDown="Timer_KeyDown" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
              <TextBlock Text="{DynamicResource DcLabel}" Margin="0,0,0,4" ToolTip="{DynamicResource DcTip}" />
              <TextBox x:Name="DcBox" AutomationProperties.Name="{DynamicResource DcLabel}" Height="36" MaxLength="18"
                       ToolTip="{DynamicResource DcTip}"
                       TextChanged="Timer_Changed" KeyDown="Timer_KeyDown" />
            </StackPanel>
            <Button x:Name="ApplyButton" Grid.Column="2" Content="{DynamicResource Apply}" VerticalAlignment="Bottom"
                    ToolTip="{DynamicResource ApplyTip}" ToolTipService.ShowOnDisabled="True"
                    Style="{StaticResource PrimaryButton}" Click="Apply_Click" IsEnabled="False" />
          </Grid>
          <TextBlock Text="{DynamicResource TimerUnits}" Style="{StaticResource Hint}" Margin="0,7,0,0" />
          <TextBlock x:Name="TimerStatus" Style="{StaticResource Hint}" Margin="0,5,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <DockPanel LastChildFill="True">
        <Button x:Name="SleepButton" DockPanel.Dock="Right" Click="Sleep_Click" ToolTip="{DynamicResource DisplayToggleTip}"
                Margin="10,0,0,0" VerticalAlignment="Top" />
        <StackPanel>
          <CheckBox x:Name="CloseToTrayCheck" Content="{DynamicResource CloseToTray}" ToolTip="{DynamicResource CloseToTrayTip}"
                    Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" />
          <CheckBox x:Name="StartupCheck" Content="{DynamicResource Startup}" ToolTip="{DynamicResource StartupTip}"
                    Margin="0,9,0,0" Checked="Startup_Changed" Unchecked="Startup_Changed" />
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="Status" Style="{StaticResource Hint}" Margin="0,8,0,0"
                 Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </ScrollViewer>
</Window>
