<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:String x:Key="LanguageLabel">Language</sys:String>
  <sys:String x:Key="LanguageSystem">Use system language</sys:String>
  <sys:String x:Key="LanguageTip">Changes the language of the window, tooltips, and menus. The system option follows the Windows display language and uses English for other languages.</sys:String>
  <sys:String x:Key="Heading">Display sleep</sys:String>
  <sys:String x:Key="Intro">Your PC keeps running while the displays are off.</sys:String>
  <sys:String x:Key="HotkeyTitle">Hotkey</sys:String>
  <sys:String x:Key="HotkeyTip">This key turns the displays off and back on while DisplayRest is running.</sys:String>
  <sys:String x:Key="CaptureTip">Records a single key or a key combination. DisplayRest checks Windows global registrations. Other apps may handle keys directly.</sys:String>
  <sys:String x:Key="CancelTip">Cancels the recording and keeps the previous hotkey.</sys:String>
  <sys:String x:Key="ClearHotkey">Clear</sys:String>
  <sys:String x:Key="ClearTip">Removes the hotkey. Keep mouse or keyboard wake enabled.</sys:String>
  <sys:String x:Key="HotkeyWaiting">Waiting for a key…</sys:String>
  <sys:String x:Key="HotkeyNone">Unassigned</sys:String>
  <sys:String x:Key="HotkeyAssign">Assign…</sys:String>
  <sys:String x:Key="HotkeyChange">Change…</sys:String>
  <sys:String x:Key="Cancel">Cancel</sys:String>
  <sys:String x:Key="CaptureHint">Press and release the key or key combination you want to use.</sys:String>
  <sys:String x:Key="HotkeyExamples">For example, Pause, Ctrl + Pause, or Ctrl + Shift + F12.</sys:String>
  <sys:String x:Key="HotkeyAvailable">The Windows global registration check passed.</sys:String>
  <sys:String x:Key="HotkeyBusy">{0} is already registered with Windows. Choose a different hotkey.</sys:String>
  <sys:String x:Key="HotkeyUnverified">Hotkey assigned. The Windows global registration check is unavailable for this shortcut.</sys:String>
  <sys:String x:Key="WakeTitle">Wake displays</sys:String>
  <sys:String x:Key="WakeMouse">Mouse movement, clicks, or scrolling</sys:String>
  <sys:String x:Key="WakeMouseTip">Lets you wake the displays by moving, clicking, or scrolling the mouse.</sys:String>
  <sys:String x:Key="WakeKeyboard">Any key press</sys:String>
  <sys:String x:Key="WakeKeyboardTip">Lets you wake the displays with any key. Your assigned hotkey wakes them regardless of this setting.</sys:String>
  <sys:String x:Key="WakeDefault">You can enable one or both wake options.</sys:String>
  <sys:String x:Key="WakeHotkey">Press {0} again to wake the displays.</sys:String>
  <sys:String x:Key="ClearNeedsWake">Enable at least one wake option before clearing the hotkey.</sys:String>
  <sys:String x:Key="WakeNeedsHotkey">Assign a hotkey or leave one wake option enabled.</sys:String>
  <sys:String x:Key="TimerTitle">Windows display timeout</sys:String>
  <sys:String x:Key="AcLabel">Plugged in</sys:String>
  <sys:String x:Key="AcTip">How long the PC stays idle before the displays turn off when plugged in. 0 means Never.</sys:String>
  <sys:String x:Key="DcLabel">On battery</sys:String>
  <sys:String x:Key="DcTip">How long the PC stays idle before the displays turn off on battery power. 0 means Never.</sys:String>
  <sys:String x:Key="Apply">Apply</sys:String>
  <sys:String x:Key="ApplyTip">Writes the display timeouts to the active Windows power plan.</sys:String>
  <sys:String x:Key="TimerUnits">Use minutes or h:mm:ss. 0 means Never.</sys:String>
  <sys:String x:Key="PlanLabel">Active power plan · {0}</sys:String>
  <sys:String x:Key="PlanUnavailable">Power plan unavailable</sys:String>
  <sys:String x:Key="TimerChanged">Windows changed the power settings. Review the updated values.</sys:String>
  <sys:String x:Key="TimerReadError">Could not read the Windows power settings (error {0}).</sys:String>
  <sys:String x:Key="TimerWriteError">Could not apply the Windows display timeout (error {0}).</sys:String>
  <sys:String x:Key="TimerPlanSwitched">Windows switched power plans during the update.</sys:String>
  <sys:String x:Key="TimerRollbackFailed">Could not restore the previous values. Check the current timeout in Windows.</sys:String>
  <sys:String x:Key="TimerInvalid">Enter a whole number of minutes or a time in h:mm:ss format.</sys:String>
  <sys:String x:Key="TimerSaved">Windows display timeout updated.</sys:String>
  <sys:String x:Key="TimerMismatch">Windows returned different values. Check the current timeout.</sys:String>
  <sys:String x:Key="DisplayOffNow">Turn off now</sys:String>
  <sys:String x:Key="DisplayOnNow">Turn on now</sys:String>
  <sys:String x:Key="DisplayToggleTip">Switches the displays between on and off.</sys:String>
  <sys:String x:Key="CloseToTray">Keep running in the tray when the window closes</sys:String>
  <sys:String x:Key="CloseToTrayTip">With this option on, closing the window hides it and keeps the hotkey active. Choose Exit DisplayRest in the tray or taskbar menu to quit.</sys:String>
  <sys:String x:Key="Startup">Start with Windows</sys:String>
  <sys:String x:Key="StartupTip">Starts DisplayRest in the tray when you sign in to Windows.</sys:String>
  <sys:String x:Key="StartupOtherPath">Startup points to another copy. Enable it for this EXE to update the path.</sys:String>
  <sys:String x:Key="StartupEnabled">Startup enabled.</sys:String>
  <sys:String x:Key="StartupDisabled">Startup disabled.</sys:String>
  <sys:String x:Key="StartupReadError">Could not read the startup setting.</sys:String>
  <sys:String x:Key="StartupWriteError">Could not change the startup setting.</sys:String>
  <sys:String x:Key="SettingsSaved">Settings saved.</sys:String>
  <sys:String x:Key="SettingsWriteError">Could not save settings.</sys:String>
  <sys:String x:Key="SettingsReadError">Could not read settings. Defaults were loaded.</sys:String>
  <sys:String x:Key="DisplayControlError">Could not start display control (error {0}).</sys:String>
  <sys:String x:Key="MenuOpen">Open DisplayRest</sys:String>
  <sys:String x:Key="MenuDisplayOff">Turn off displays</sys:String>
  <sys:String x:Key="MenuDisplayOn">Turn on displays</sys:String>
  <sys:String x:Key="MenuExit">Exit DisplayRest</sys:String>
</ResourceDictionary>
