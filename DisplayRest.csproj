<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OptimizationPreference>Size</OptimizationPreference>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DisplayRest.ico</ApplicationIcon>
    <AssemblyName>PCRest</AssemblyName>
    <AssemblyTitle>PC Rest</AssemblyTitle>
    <Product>DisplayRest</Product>
    <Version>1.3.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>PC Rest — дисплеи, сон компьютера и пресеты Windows</Description>
  </PropertyGroup>
  <Target Name="UseServicedAotCompiler" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler"
                           Condition="'%(TargetFramework)' == 'net10.0' and $([MSBuild]::VersionLessThan('%(ILCompilerPackVersion)', '10.0.15'))"
                           ILCompilerPackVersion="10.0.15" />
    </ItemGroup>
  </Target>
</Project>
